{
  "name": "seans-landing",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/vendor.mjs && nuxt dev",
    "generate": "node scripts/vendor.mjs && nuxt generate && node scripts/check-site.mjs",
    "preview": "python3 -m http.server 4173 -d .output/public",
    "check": "node scripts/check-site.mjs",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "gsap": "3.15.0",
    "marked": "18.1.1",
    "nuxt": "4.6.3",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "ionicons": "8.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13"
  }
}
